diff --git a/src/mingw_compat.h b/src/mingw_compat.h
new file mode 100644
index 0000000..dae417a
--- /dev/null
+++ b/src/mingw_compat.h
@@ -0,0 +1,17 @@
+// MinGW provides neither the GNU `uint` nor the BSD `u_intN_t` typedefs that
+// rapidsnark and ffiasm use throughout. CMake force-includes this on WIN32.
+// <stdint.h> rather than <cstdint>: it is included into C sources too.
+#ifndef RAPIDSNARK_MINGW_COMPAT_H
+#define RAPIDSNARK_MINGW_COMPAT_H
+
+#ifdef __MINGW32__
+#include <stdint.h>
+#include <sys/types.h>
+typedef unsigned int uint;
+typedef uint8_t  u_int8_t;
+typedef uint16_t u_int16_t;
+typedef uint32_t u_int32_t;
+typedef uint64_t u_int64_t;
+#endif
+
+#endif
