@@ -20,6 +24,58 @@ FileLoader::FileLoader(const std::string& fileName)
     load(fileName);
 }
 
+#ifdef _WIN32
+
+// Windows has no mmap; a read-only file mapping is the direct equivalent.
+// `fd` stays the loaded/not-loaded sentinel so the header is unchanged.
+static HANDLE g_file    = INVALID_HANDLE_VALUE;
+static HANDLE g_mapping = nullptr;
+
+void FileLoader::load(const std::string& fileName)
+{
+    if (fd != -1) {
+        throw std::invalid_argument("file already loaded");
+    }
+
+    g_file = CreateFileA(fileName.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr,
+                         OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+    if (g_file == INVALID_HANDLE_VALUE)
+        throw std::system_error(GetLastError(), std::system_category(), "CreateFile");
+
+    LARGE_INTEGER fileSize;
+    if (!GetFileSizeEx(g_file, &fileSize)) {
+        CloseHandle(g_file);
+        throw std::system_error(GetLastError(), std::system_category(), "GetFileSizeEx");
+    }
+    size = static_cast<size_t>(fileSize.QuadPart);
+
+    g_mapping = CreateFileMappingA(g_file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+    if (g_mapping == nullptr) {
+        CloseHandle(g_file);
+        throw std::system_error(GetLastError(), std::system_category(), "CreateFileMapping");
+    }
+
+    addr = MapViewOfFile(g_mapping, FILE_MAP_READ, 0, 0, 0);
+    if (addr == nullptr) {
+        CloseHandle(g_mapping);
+        CloseHandle(g_file);
+        throw std::system_error(GetLastError(), std::system_category(), "MapViewOfFile");
+    }
+
+    fd = 0;
+}
+
+FileLoader::~FileLoader()
+{
+    if (fd != -1) {
+        UnmapViewOfFile(addr);
+        CloseHandle(g_mapping);
+        CloseHandle(g_file);
+    }
+}
+
